# Copy this file to .env.test (git-ignored). Used only by `npm run test:integration`.
# Values match the postgres-test service in docker-compose.yml (host port 5434).
# Start the database first: docker compose up -d postgres-test
PORT=3001

DB_HOST=localhost
DB_PORT=5434
DB_NAME=pet_adoption_test
DB_USER=pet_test_user
DB_PASSWORD='pet_test_password'

# Any value works for tests; never reuse the real secret.
JWT_SECRET=test-secret-not-for-production
