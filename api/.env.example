# Copy this file to .env (git-ignored) and adjust the values.
# docker-compose.yml reads the same DB_* variables to create the local Postgres.

# Port the API listens on
PORT=3000

# Postgres connection (DB_PORT is also the host port docker compose publishes)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pet_adoption
DB_USER=pet_user

# ใส่ DB_PASSWORD ในเครื่องหมายคำพูดเดี่ยว ('...') เสมอ
# เพื่อกันปัญหาทั้ง # (ถูกตีความเป็นคอมเมนต์ ทำให้รหัสผ่านถูกตัดกลางคัน)
# และ $ (docker compose ตีความเป็นตัวแปร ทำให้ค่าเพี้ยนหรือหาย)
# ข้อจำกัด: รหัสผ่านต้องไม่มีเครื่องหมายคำพูดเดี่ยว (') อยู่ข้างใน
DB_PASSWORD='change-me-locally'
