# Copy this file to .env (git-ignored) and adjust the values.
# docker-compose.yml reads the same DB_* variables to create the local Postgres.

# Port the API listens on (defaults to 3000 when unset)
PORT=3000

# Websites allowed to call the API from a browser, comma-separated, e.g.
# https://your-web-app.example.com (no path, "*" is rejected). Leave empty for
# local dev: the Vite proxy makes CORS unnecessary.
CORS_ORIGIN=

# Postgres connection (DB_PORT is also the host port docker compose publishes)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pet_adoption
DB_USER=pet_user

# ใส่ DB_PASSWORD ในเครื่องหมายคำพูดเดี่ยว ('...') เสมอ
# เพื่อกันปัญหาทั้ง # (ถูกตีความเป็นคอมเมนต์ ทำให้รหัสผ่านถูกตัดกลางคัน)
# และ $ (docker compose ตีความเป็นตัวแปร ทำให้ค่าเพี้ยนหรือหาย)
# ข้อจำกัด: รหัสผ่านต้องไม่มีเครื่องหมายคำพูดเดี่ยว (') อยู่ข้างใน
DB_PASSWORD='change-me-locally'

# Set to true for a managed Postgres that requires SSL (e.g. Neon). The server
# certificate is always verified. Keep false for the local Postgres.
DB_SSL=false

# Optional connection pool tuning. Leave empty locally (defaults: 10
# connections, 2000 ms). For Vercel + Neon, 5 and 10000 are a good start.
DB_POOL_MAX=
DB_CONNECTION_TIMEOUT_MS=

# Secret used to sign JWTs. Use a long random string, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-locally

# Gemini API key for AI application summaries (get one from Google AI Studio)
GEMINI_API_KEY=
# Gemini model name to use for summaries
AI_MODEL=
